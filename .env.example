# recent-activity panel (all optional; a missing source just shows as "–")
GITHUB_TOKEN=            # raises the github api rate limit, read-only public scope is enough
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=    # printed once by /api/strava/callback

# prikbord (message board); without these the board is hidden
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRIKBORD_SALT=           # any random string, salts the hashed ip used for rate limiting

# the desk (/desk): identity-only owner Google sign-in; no Gmail/calendar permission until Connect is approved
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://maramasaeva.com/api/desk/google/callback
GOOGLE_ALLOWED_EMAILS=maramasaeva@gmail.com
DESK_SESSION_SECRET=     # random, 32+ bytes; rotating it signs every device out
PRIVATE_REPLY_QUEUE_URL= # legacy /desk/replies link; new messaging uses the server-side relay below
X_API_KEY=               # consumer key of the "maramasaeva" app in the x developer console
X_API_SECRET=
X_ACCESS_TOKEN=          # user-context token for @rssmrm, read and write
X_ACCESS_SECRET=
X_BEARER_TOKEN=          # app-only token, used for reads
# dashboard gateway: server only, never prefix these with NEXT_PUBLIC_
# HTTPS ORIGIN only, no /app path. Tunnel must accept machine requests (not interactive OAuth).
DASHBOARD_GATEWAY_URL=
DASHBOARD_GATEWAY_TOKEN= # separate private DASHBOARD_RELAY_TOKEN, never the main gateway token
OPENAI_API_KEY=          # drafts; or ANTHROPIC_API_KEY=. DESK_PROVIDER=openai|anthropic picks, DESK_MODEL overrides the model
